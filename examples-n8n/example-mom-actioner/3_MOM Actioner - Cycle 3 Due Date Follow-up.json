        "text": "={{ $json.chatInput || $json.text || $json.snippet }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You extract action items from meeting minutes.\n\nReturn ONLY a JSON array. No prose, no markdown fences.\n\nEach element:\n{\n  \"action\": string,\n  \"owner\": string | null,\n  \"due_date\": string | null\n}\n\nRules:\n- owner is null when the notes say Unassigned, TBD, or leave it blank.\n- due_date is an ISO date (YYYY-MM-DD) only when the notes give a real calendar date. If the notes say something vague like \"Next review\" or \"Week of ...\", set it to null.\n- Never invent an owner or a date. Copy the action text as written.\n- If there are no action items at all, return []."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -400,
        60
      ],
      "id": "a3000000-0000-4000-8000-000000000303",
      "name": "MOM Actioner"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -400,
        280
