      "id": "a3000000-0000-4000-8000-000000000304",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "MJmu5iG6bJB5dd48",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text ?? $input.first().json.output ?? '';\n\nlet items;\ntry {\n  items = JSON.parse(String(raw).replace(/```json\\n?|```/g, '').trim());\n} catch (e) {\n  items = [];\n}\nif (!Array.isArray(items)) items = [];\n\nconst first = items[0];\nif (!first) return [];\n\nconst date = first.due_date;\n\nreturn [{\n  json: {\n    action: first.action,\n    owner: first.owner,\n    due_date: date,\n    event_start: date ? date + 'T09:00:00+02:00' : null,\n    event_end: date ? date + 'T09:30:00+02:00' : null,\n    total_items_found: items.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        60
      ],
      "id": "a3000000-0000-4000-8000-000000000305",
      "name": "Take the first action item"
