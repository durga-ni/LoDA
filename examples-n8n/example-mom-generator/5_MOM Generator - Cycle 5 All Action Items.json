    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput || $json.text || $json.snippet }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You extract action items from meeting minutes.\n\nReturn ONLY a JSON array. No prose, no markdown fences.\n\nEach element:\n{\n  \"action\": string,\n  \"owner\": string | null,\n  \"due_date\": string | null\n}\n\nRules:\n- owner is null when the notes say Unassigned, TBD, or leave it blank.\n- due_date is an ISO date (YYYY-MM-DD) only when the notes give a real calendar date. If the notes say something vague like \"Next review\" or \"Week of ...\", set it to null.\n- Never invent an owner or a date. Copy the action text as written.\n- If there are no action items at all, return []."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -620,
        60
      ],
      "id": "a4000000-0000-4000-8000-000000000403",
      "name": "MOM Generator"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -620,
        280
      ],
      "id": "a4000000-0000-4000-8000-000000000404",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "MJmu5iG6bJB5dd48",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text ?? $input.first().json.output ?? '';\n\nlet items;\ntry {\n  items = JSON.parse(String(raw).replace(/```json\\n?|```/g, '').trim());\n} catch (e) {\n  items = [];\n}\nif (!Array.isArray(items)) items = [];\n\n// The empty case still has to travel down the workflow, so it gets one item of its own.\nif (items.length === 0) {\n  return [{ json: { no_action_items: true } }];\n}\n\n// One n8n item per action item - this is what makes the rest of the workflow run once each.\nreturn items.map(i => {\n  const date = i.due_date;\n  return {\n    json: {\n      no_action_items: false,\n      action: i.action,\n      owner: i.owner,\n      due_date: date,\n      event_start: date ? date + 'T09:00:00+02:00' : null,\n      event_end: date ? date + 'T09:30:00+02:00' : null\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        60
      ],
      "id": "a4000000-0000-4000-8000-000000000405",
      "name": "Parse all action items"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d4000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.no_action_items }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -140,
