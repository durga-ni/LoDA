        "jsCode": "// One item per attendee: the agent wrote subject/body/notes, the booking adds the facts.\nconst plan = $('Host').first().json.output.plan;\nconst b = $('Book table').first().json;\nconst details = `\\n\\nWhere: ${b.restaurant_name}, ${b.address}\\nWhen: ${b.date} at ${b.time}\\nReservation: ${b.confirmation_id} (table for ${b.party_size})`;\nreturn plan.attendees.map(a => ({ json: {\n  to: a.email,\n  name: a.name,\n  subject: plan.invite_subject,\n  body: plan.invite_body + details + (a.note ? `\\n\\nP.S. ${a.name}: ${a.note}` : ''),\n}}));\n"
