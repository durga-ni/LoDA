    {
      "parameters": {
        "name": "remember_fact",
        "description": "Store something learned this conversation about a person, e.g. a new restriction or an email address for someone not in long-term memory.",
        "jsCode": "const q = typeof query === 'string' ? JSON.parse(query) : (query || {});\nlet st;\ntry { st = $getWorkflowStaticData('global'); } catch (e) { return JSON.stringify({ error: 'static data unavailable' }); }\nst.facts = st.facts || {};\nconst key = String(q.name || '').trim().toLowerCase();\nif (!key) return JSON.stringify({ error: 'name is required' });\nconst f = st.facts[key] || {};\nif (q.email) f.email = q.email;\nif (Array.isArray(q.dietary_restrictions) && q.dietary_restrictions.length) f.dietary_restrictions = q.dietary_restrictions;\nst.facts[key] = f;\nreturn JSON.stringify({ stored: { name: q.name, ...f } });\n",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"email\": {\n      \"type\": \"string\"\n    },\n    \"dietary_restrictions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"name\"\n  ]\n}"
      },
