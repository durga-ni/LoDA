    {
      "parameters": {
        "name": "get_friend_profiles",
        "description": "Look up guests in long-term memory: email, dietary restrictions, contact preference. Facts learned this conversation are merged in.",
        "jsCode": "const q = typeof query === 'string' ? JSON.parse(query) : (query || {});\nconst FRIENDS = [{\"name\": \"Alice\", \"email\": \"alice@example.com\", \"dietary_restrictions\": [\"vegetarian\"], \"contact_preference\": \"email\"}, {\"name\": \"Bob\", \"email\": \"bob@example.com\", \"dietary_restrictions\": [\"dairy allergy\"], \"contact_preference\": \"email\"}, {\"name\": \"Charlie\", \"email\": \"charlie@example.com\", \"dietary_restrictions\": [\"gluten-free\"], \"contact_preference\": \"email\"}];          // long-term memory\nlet facts = {};                          // session facts written by remember_fact\ntry { facts = $getWorkflowStaticData('global').facts || {}; } catch (e) {}\nconst profiles = [], unknown = [];\nfor (const raw of (q.names || [])) {\n  const key = String(raw).trim().toLowerCase();\n  const p = FRIENDS.find(f => f.name.toLowerCase() === key);\n  const f = facts[key] || {};\n  if (p) profiles.push({ ...p, ...f });            // session overrides long-term\n  else if (Object.keys(f).length) profiles.push({ name: raw, ...f });\n  else unknown.push(raw);\n}\nreturn JSON.stringify({ profiles, unknown });\n",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"names\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"names\"\n  ]\n}"
      },
      "name": "get_friend_profiles",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        464,
